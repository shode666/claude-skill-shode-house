.DS_Store
.idea/
.vscode/
*.log
node_modules/
.env
.env.local
__pycache__/
*.pyc
/outputs/
# Local synthetic projects and benchmark artifacts (not the tracked tests/ suite)
/test/
# Zip temp files from failed builds (random-named mktemp artifacts)
zi[a-zA-Z][a-zA-Z][a-zA-Z][a-zA-Z][a-zA-Z]*
ziqn*
ziq*
# FUSE mount artifacts (transient, sandbox-only)
.fuse_hidden*
# Plugin build artifacts — ship via GitHub Releases / make pack, keep only current
shode-house-v*.plugin
!shode-house-v3.7.0.plugin

/eval/prompts/resolved/

# Cowork side-panel exports
Claude outputs/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/

# Local-only: Claude Code local settings, Beads gate lock
.claude/settings.local.json
.beads.gate.lock

# Live eval evidence: only summaries/scores are tracked (public repo). Raw traces and
# machine-describing files stay local (size, session ids, local paths, host info).
/eval/baseline/*-probe*/*/*
!/eval/baseline/*-probe*/*/score.txt
!/eval/baseline/*-probe*/*/prompt.txt
/eval/baseline/*-n5/*/
/eval/baseline/*/BATCH.json
/eval/baseline/*/log.txt
