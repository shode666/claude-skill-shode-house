      "security_triggers": {"keywords": ["ledger", "money", "refund", "เลขบัตร", "card"],
                            "required_agents": ["shode-house:security-engineer"]},
      "relay_expected": false,
      "end_state": {"bd_status": ["OPEN", "CLOSED"], "notes_pattern": "Standards|Spec|verdict|PASS|FAIL"}
