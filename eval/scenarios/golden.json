    {
      "id": "GS1-reference-refund",
      "command": "/review",
      "golden": true,
      "desc": "reference project shode666/shode-house-example-refund \u2014 partial refund + ledger pipeline (docs/pipeline/01..08), Sentinel+Felix money trigger",
      "bd_id": null,
      "agents": [
        "code-reviewer",
        "qa-engineer",
        "business-analyst",
        "fintech-expert",
        "security-engineer",
        "developer"
      ],
      "expected_routing": [
        {
          "agents": [
            "shode-house:code-reviewer",
            "shode-house:qa-engineer",
            "shode-house:business-analyst",
            "shode-house:fintech-expert",
            "shode-house:security-engineer"
          ],
          "parallel": true
        },
        {
          "agents": [
            "shode-house:developer"
          ],
          "optional": true
        }
