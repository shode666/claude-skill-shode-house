    {
      "id": "GS1-reference-refund",
      "command": "/review",
      "golden": true,
      "desc": "reference project shode666/shode-house-example-refund — partial refund + ledger pipeline (docs/pipeline/01..08), Sentinel+Felix money trigger",
      "bd_id": null,
      "agents": ["code-reviewer", "qa-engineer", "business-analyst", "fintech-expert", "security-engineer", "developer"],
