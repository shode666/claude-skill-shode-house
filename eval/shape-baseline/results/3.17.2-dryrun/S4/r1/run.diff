   { date: "2026-01-15", order: "#09934", amount: 760.0, status: "สำเร็จ" },
 ];
 
+const DAY_MS = 24 * 60 * 60 * 1000;
+
+// Calendar-day number of a "YYYY-MM-DD" string or a Date's local Y/M/D.
+// Uses UTC arithmetic on the calendar fields, so no timezone/DST off-by-one.
+function dayNumber(y, m, d) {
+  return Date.UTC(y, m - 1, d) / DAY_MS;
+}
+
+function parseDay(str) {
+  const [y, m, d] = str.split("-").map(Number);
+  return dayNumber(y, m, d);
+}
+
+// Keep rows dated within the last `days` days up to `today`, inclusive of the boundary day.
+// Rows dated after `today` are excluded.
+function filterByRange(rows, days, today = new Date()) {
+  const t = dayNumber(today.getFullYear(), today.getMonth() + 1, today.getDate());
+  return rows.filter((r) => {
+    const age = t - parseDay(r.date);
+    return age >= 0 && age <= days;
+  });
+}
