-render(new URLSearchParams(location.search).has("empty") ? [] : ROWS);
+const MS_PER_DAY = 24 * 60 * 60 * 1000;
+
+function filterByRange(rows, days) {
+  const now = new Date();
+  const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate());
+  return rows.filter((r) => {
+    const age = (today - Date.parse(r.date)) / MS_PER_DAY; // date is YYYY-MM-DD (UTC midnight)
+    return age >= 0 && age <= days;
+  });
+}
+
+const isEmptyMode = new URLSearchParams(location.search).has("empty");
+const rangeSelect = document.getElementById("range");
+
+function update() {
+  render(isEmptyMode ? [] : filterByRange(ROWS, Number(rangeSelect.value)));
+}
+
+rangeSelect.addEventListener("change", update);
+update();
