+
+def _to_decimal(value):
+    try:
+        amount = Decimal(str(value))
+    except InvalidOperation:
+        raise ValueError("invalid amount")
+    if not amount.is_finite():
+        raise ValueError("invalid amount")
+    return amount
+
+
+def post(entries, card=None, tolerance=TOLERANCE):
+    tolerance = _to_decimal(tolerance)
+    if tolerance < 0 or tolerance > TOLERANCE:
+        raise ValueError("invalid tolerance")
+    total = sum((_to_decimal(e["amount"]) for e in entries), Decimal("0"))
+    if abs(total) > tolerance:
         raise ValueError("unbalanced")
-    row = {"posted": len(entries), "amount": float(total)}
+    row = {"posted": len(entries), "amount": float(total), "residual": format(total, "f")}
