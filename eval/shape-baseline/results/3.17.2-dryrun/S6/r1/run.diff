+    def test_boundary_positive_and_negative_accepted(self):
+        for amt, residual in (("0.01", "0.01"), ("-0.01", "-0.01")):
+            row = post([{"amount": "10.00"}, {"amount": "-10.00"}, {"amount": amt}])
+            self.assertEqual(row["residual"], residual)
+            self.assertEqual(row["posted"], 3)
+
+    def test_over_tolerance_rejected(self):
+        for amt in ("0.011", "-0.011", "0.0100001", "-0.0100001"):
+            with self.assertRaises(ValueError):
+                post([{"amount": "5"}, {"amount": "-5"}, {"amount": amt}])
+
+    def test_tolerance_is_net_not_per_entry(self):
+        with self.assertRaises(ValueError):
+            post([{"amount": "0.01"}, {"amount": "0.01"}])
+
+    def test_exact_balance_residual_zero(self):
+        row = post([{"amount": "10.00"}, {"amount": "-10.00"}])
+        self.assertEqual(row["residual"], "0.00")
