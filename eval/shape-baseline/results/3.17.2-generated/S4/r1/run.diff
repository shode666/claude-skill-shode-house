-render(new URLSearchParams(location.search).has("empty") ? [] : ROWS);
+const MS_PER_DAY = 86400000;
+
+// Day number from a calendar date; date-only via UTC so no timezone/DST off-by-one.
+function toDayNumber(year, month, day) {
+  return Math.floor(Date.UTC(year, month, day) / MS_PER_DAY);
+}
+
+function rowsWithinDays(rows, days) {
+  const now = new Date();
+  const today = toDayNumber(now.getFullYear(), now.getMonth(), now.getDate());
+  return rows.filter((r) => {
+    const [y, m, d] = r.date.split("-").map(Number);
+    const age = today - toDayNumber(y, m - 1, d);
+    return age >= 0 && age <= days;
+  });
+}
+
+const forceEmpty = new URLSearchParams(location.search).has("empty");
+const rangeSelect = document.getElementById("range");
+
+function update() {
+  render(forceEmpty ? [] : rowsWithinDays(ROWS, Number(rangeSelect.value)));
+}
+
+rangeSelect.addEventListener("change", update);
+update();
