-render(new URLSearchParams(location.search).has("empty") ? [] : ROWS);
+function withinDays(rows, days) {
+  const cutoff = new Date().getTime() - days * 24 * 60 * 60 * 1000;
+  return rows.filter((r) => new Date(r.date).getTime() >= cutoff);
+}
+
+function update() {
+  const empty = new URLSearchParams(location.search).has("empty");
+  const days = Number(document.getElementById("range").value);
+  render(empty ? [] : withinDays(ROWS, days));
+}
+
+document.getElementById("range").addEventListener("change", update);
+update();
