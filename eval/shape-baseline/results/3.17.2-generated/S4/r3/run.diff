-render(new URLSearchParams(location.search).has("empty") ? [] : ROWS);
+const MS_PER_DAY = 86400000;
+
+// Parse YYYY-MM-DD as a UTC day number (timezone-independent).
+function toDayNumber(ymd) {
+  const [y, m, d] = ymd.split("-").map(Number);
+  return Date.UTC(y, m - 1, d) / MS_PER_DAY;
+}
+
+// Rows dated within the last `days` days of today (local calendar date), inclusive.
+function filterByRange(rows, days) {
+  const now = new Date();
+  const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / MS_PER_DAY;
+  return rows.filter((r) => {
+    const age = today - toDayNumber(r.date);
+    return age >= 0 && age <= days;
+  });
+}
+
+const isEmptyParam = new URLSearchParams(location.search).has("empty");
+const rangeSelect = document.getElementById("range");
+
+function update() {
+  render(isEmptyParam ? [] : filterByRange(ROWS, Number(rangeSelect.value)));
+}
+
+rangeSelect.addEventListener("change", update);
+update();
