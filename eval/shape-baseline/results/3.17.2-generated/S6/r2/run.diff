+import logging
+from decimal import Decimal, InvalidOperation
+
+logger = logging.getLogger(__name__)
+
+# Max accepted |sum(entries)| per post() call (upstream rounding mismatch). Inclusive.
+TOLERANCE = Decimal("0.01")
 
 def mask_card(pan):
     return pan[:6] + "*" * (len(pan) - 10) + pan[-4:]
 
+def parse_amount(raw):
+    if raw is None or isinstance(raw, bool):
+        raise ValueError("invalid amount")
+    try:
+        amount = Decimal(str(raw))
+    except InvalidOperation:
+        raise ValueError("invalid amount") from None
+    if not amount.is_finite():
+        raise ValueError("invalid amount")
+    return amount
+
 def post(entries, card=None):
-    total = sum(Decimal(str(e["amount"])) for e in entries)
-    if total != 0:
+    total = sum((parse_amount(e["amount"]) for e in entries), Decimal(0))
+    if abs(total) > TOLERANCE:
         raise ValueError("unbalanced")
-    row = {"posted": len(entries), "amount": float(total)}
+    if total != 0:
+        logger.warning("ledger post tolerated residual=%s posted=%d", total, len(entries))
+    row = {"posted": len(entries), "amount": float(total), "residual": str(total)}
     if card:
         row["card"] = mask_card(card)
         print(f"ledger post card={card}")
