+from decimal import Decimal, InvalidOperation
 
 def mask_card(pan):
     return pan[:6] + "*" * (len(pan) - 10) + pan[-4:]
 
+TOLERANCE = Decimal("0.01")
+
+
+def _parse_amount(entry):
+    """Return a finite Decimal for entry["amount"] or raise ValueError."""
+    try:
+        raw = entry["amount"]
+    except (KeyError, TypeError, IndexError):
+        raise ValueError("invalid amount: missing") from None
+    if raw is None or isinstance(raw, bool):
+        raise ValueError("invalid amount")
+    if isinstance(raw, str) and (raw != raw.strip() or "_" in raw):
+        raise ValueError("invalid amount")
+    try:
+        value = Decimal(str(raw))
+    except (InvalidOperation, ValueError):
+        raise ValueError("invalid amount") from None
+    if not value.is_finite():
+        raise ValueError("invalid amount")
+    return value
+
+
 def post(entries, card=None):
-    total = sum(Decimal(str(e["amount"])) for e in entries)
+    amounts = [_parse_amount(e) for e in entries]
+    total = sum(amounts)
+    tolerance_applied = False
     if total != 0:
-        raise ValueError("unbalanced")
-    row = {"posted": len(entries), "amount": float(total)}
+        has_mixed_signs = (
+            len(amounts) >= 2
+            and any(a > 0 for a in amounts)
+            and any(a < 0 for a in amounts)
+        )
+        if not (has_mixed_signs and abs(total) <= TOLERANCE):
+            raise ValueError("unbalanced")
+        tolerance_applied = True
+    residual = format(total, "f") if total != 0 else "0.00"
+    row = {
+        "posted": len(entries),
+        "amount": float(total),
+        "residual": residual,
+        "tolerance_applied": tolerance_applied,
+    }
     if card:
         row["card"] = mask_card(card)
         print(f"ledger post card={card}")
