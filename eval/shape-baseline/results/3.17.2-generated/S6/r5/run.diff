--- a/src/ledger.py
+++ b/src/ledger.py
@@ -1,12 +1,41 @@
-from decimal import Decimal
+import logging
+from decimal import Decimal, Context, Inexact, InvalidOperation, Rounded
+
+logger = logging.getLogger(__name__)
+
+# bd-104: upstream rounding can leave up to 0.01 one-sided. Fixed module
+# constant on purpose: not a parameter, not read from env or from entries.
+LEDGER_ROUNDING_TOLERANCE = Decimal("0.01")
+
+# bd-104 S8: any rounding of the sum raises instead of silently hiding an imbalance.
+_EXACT_CONTEXT = Context(prec=28, traps=[InvalidOperation, Inexact, Rounded])
 
 def mask_card(pan):
     return pan[:6] + "*" * (len(pan) - 10) + pan[-4:]
 
+def _sum_exact(entries):
+    total = Decimal(0)
+    try:
+        for e in entries:
+            amount = Decimal(str(e["amount"]))
+            if not amount.is_finite():
+                raise ValueError("unbalanced: non-finite amount")
+            total = _EXACT_CONTEXT.add(total, amount)
+    except ArithmeticError as exc:
+        raise ValueError("unbalanced: invalid or inexact amount") from exc
+    return total
+
 def post(entries, card=None):
-    total = sum(Decimal(str(e["amount"])) for e in entries)
-    if total != 0:
+    entries = list(entries)  # accept any iterable; len() is needed below
+    total = _sum_exact(entries)
+    # copy_abs() is context-free (abs() rounds to the caller's ambient precision, bd-104 M-1).
+    if not total.is_finite() or total.copy_abs() > LEDGER_ROUNDING_TOLERANCE:
         raise ValueError("unbalanced")
+    if total != 0 and len(entries) < 2:
+        raise ValueError("unbalanced")  # no one-sided entries (bd-104 S9)
+    if total != 0:
+        # bd-104 S5/S6: audit line, never include the card/PAN.
+        logger.warning("ledger post tolerated residual entries=%d residual=%s", len(entries), total)
     row = {"posted": len(entries), "amount": float(total)}
     if card:
         row["card"] = mask_card(card)
