-render(new URLSearchParams(location.search).has("empty") ? [] : ROWS);
+const MS_PER_DAY = 86400000;
+
+// Calendar-day number for a YYYY-MM-DD string (UTC math, so no timezone/DST shift). NaN if malformed.
+function dayNumber(ymd) {
+  const m = /^(\d{4})-(\d{2})-(\d{2})$/.exec(ymd);
+  return m ? Date.UTC(+m[1], +m[2] - 1, +m[3]) / MS_PER_DAY : NaN;
+}
+
+// Rows dated within the last `days` calendar days up to and including `now`'s local date.
+// Boundary inclusive; future-dated and malformed rows are excluded.
+function filterByRange(rows, days, now) {
+  const today = Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / MS_PER_DAY;
+  return rows.filter((r) => {
+    const age = today - dayNumber(r.date);
+    return age >= 0 && age <= days;
+  });
+}
+
+if (typeof document !== "undefined") {
+  const range = document.getElementById("range");
+  const is_empty_mode = new URLSearchParams(location.search).has("empty");
+  const refresh = () => render(is_empty_mode ? [] : filterByRange(ROWS, Number(range.value), new Date()));
+  range.addEventListener("change", refresh);
+  refresh();
+}
+
+if (typeof module !== "undefined") module.exports = { filterByRange, dayNumber, ROWS };
