+// Keep rows dated within the last `days` days (date-only, local time, boundary day inclusive).
+function filterByRange(rows, days, now = new Date()) {
+  const cutoff = new Date(now.getFullYear(), now.getMonth(), now.getDate() - days);
+  return rows.filter((r) => {
+    const [y, m, d] = r.date.split("-").map(Number);
+    return new Date(y, m - 1, d) >= cutoff;
+  });
+}
+
+const isEmptyMode = new URLSearchParams(location.search).has("empty");
+const rangeSelect = document.getElementById("range");
+
+function renderForRange() {
+  render(isEmptyMode ? [] : filterByRange(ROWS, Number(rangeSelect.value)));
+}
+
+rangeSelect.addEventListener("change", renderForRange);
+renderForRange();
