+// Test seam: window.REFUND_TODAY ("YYYY-MM-DD") overrides the wall clock.
+function todayIso() {
+  if (window.REFUND_TODAY) return window.REFUND_TODAY;
+  const d = new Date();
+  const pad = (n) => String(n).padStart(2, "0");
+  return `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
+}
+
+// Rows dated within the last `days` days, cutoff day inclusive, future-dated rows excluded (date-only math, UTC, no TZ drift).
+function filterByRange(rows, days) {
+  const [y, m, d] = todayIso().split("-").map(Number);
+  const cutoff = new Date(Date.UTC(y, m - 1, d - days)).toISOString().slice(0, 10);
+  return rows.filter((r) => r.date >= cutoff && r.date <= todayIso());
+}
+
+const IS_EMPTY_MODE = new URLSearchParams(location.search).has("empty");
+const rangeSelect = document.getElementById("range");
+
+function refresh() {
+  render(IS_EMPTY_MODE ? [] : filterByRange(ROWS, Number(rangeSelect.value)));
+}
+
+rangeSelect.addEventListener("change", refresh);
+refresh(); // initial render follows the select's current value (30 by default)
