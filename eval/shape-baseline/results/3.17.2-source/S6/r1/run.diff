-from decimal import Decimal
+from decimal import Decimal, InvalidOperation, Inexact, localcontext
+
+ROUNDING_TOLERANCE = Decimal("0.01")  # inclusive; THB scale 2 only
+# shortcut(bd:ledger-tolerance): placeholder CoA code, finance must confirm (Felix Q1)
+ROUNDING_ACCOUNT = "ROUNDING-DIFFERENCE-TBD"
 
 def mask_card(pan):
     return pan[:6] + "*" * (len(pan) - 10) + pan[-4:]
 
+def to_amount(raw):
+    if isinstance(raw, bool) or not isinstance(raw, (str, int, Decimal)):
+        raise ValueError("amount must be str, int or Decimal")
+    try:
+        amount = Decimal(raw)
+    except InvalidOperation:
+        raise ValueError("amount is not a number")
+    if not amount.is_finite():
+        raise ValueError("amount must be finite")
+    if amount.as_tuple().exponent < -2:
+        raise ValueError("amount has more than 2 decimal places")
+    return amount
+
+def entry_amount(entry):
+    if not isinstance(entry, dict) or "amount" not in entry:
+        raise ValueError("entry must be a dict with an amount")
+    return to_amount(entry["amount"])
+
+def exact_sum(entries):
+    # Any rounding (e.g. 1E+30 + 5.00 at 28 digits) would hide an imbalance: fail instead.
+    with localcontext() as ctx:
+        ctx.traps[Inexact] = True
+        try:
+            return sum((entry_amount(e) for e in entries), Decimal("0"))
+        except Inexact:
+            raise ValueError("amount too large to sum exactly")
+
+def exact_negate(value):
+    with localcontext() as ctx:
+        ctx.traps[Inexact] = True
+        try:
+            return -value
+        except Inexact:
+            raise ValueError("amount too large to negate exactly")
+
 def post(entries, card=None):
-    total = sum(Decimal(str(e["amount"])) for e in entries)
+    if len(entries) < 2:
+        raise ValueError("at least 2 entries required")
+    total = exact_sum(entries)
+    if abs(total) > ROUNDING_TOLERANCE:
+        raise ValueError("unbalanced")
+    journal = list(entries)
     if total != 0:
+        journal.append({"amount": str(exact_negate(total)), "account": ROUNDING_ACCOUNT, "type": "rounding"})
+    stored = exact_sum(journal)
+    if stored != 0:
         raise ValueError("unbalanced")
-    row = {"posted": len(entries), "amount": float(total)}
+    row = {"posted": len(journal), "amount": str(stored), "rounding_residual": str(total)}
     if card:
         row["card"] = mask_card(card)
-        print(f"ledger post card={card}")
     return row
