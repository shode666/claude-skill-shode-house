-import os, sys, unittest
+import contextlib, io, os, sys, unittest
+from decimal import Decimal
 sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "src"))
 from ledger import post
 
 
+def amounts(*values):
+    return [{"amount": v} for v in values]
+
+
 class LedgerPostTest(unittest.TestCase):
     def test_unbalanced_raises(self):
         with self.assertRaises(ValueError):
             post([{"amount": "10.00"}])
 
+    def test_exact_balance_has_no_rounding_entry(self):
+        row = post(amounts("10.00", "-10.00"))
+        self.assertEqual(row["posted"], 2)
+        self.assertEqual(Decimal(row["rounding_residual"]), 0)
+        self.assertEqual(Decimal(row["amount"]), 0)
+
+    def test_positive_boundary_posts_with_rounding_entry(self):
+        row = post(amounts("10.00", "-9.99"))
+        self.assertEqual(row["rounding_residual"], "0.01")
+        self.assertEqual(row["posted"], 3)
+        self.assertEqual(Decimal(row["amount"]), 0)
+
+    def test_negative_boundary_posts_with_rounding_entry(self):
+        row = post(amounts("10.00", "-10.01"))
+        self.assertEqual(row["rounding_residual"], "-0.01")
+        self.assertEqual(row["posted"], 3)
+        self.assertEqual(Decimal(row["amount"]), 0)
+
+    def test_beyond_tolerance_raises(self):
+        for pair in (("10.00", "-9.98"), ("10.00", "-10.02")):
+            with self.assertRaises(ValueError):
+                post(amounts(*pair))
+
+    def test_single_entry_within_tolerance_raises(self):
+        with self.assertRaises(ValueError):
+            post(amounts("0.01"))
+
+    def test_empty_raises(self):
+        with self.assertRaises(ValueError):
+            post([])
+
+    def test_non_finite_raises_value_error(self):
+        for bad in ("NaN", "sNaN", "Infinity", "-Infinity"):
+            with self.assertRaises(ValueError):
+                post(amounts(bad, "0"))
+
+    def test_float_raises(self):
+        with self.assertRaises(ValueError):
+            post(amounts(10.0, -9.99))
+
+    def test_more_than_two_decimal_places_raises(self):
+        for bad in ("10.005", "0.009", "0.011"):
+            with self.assertRaises(ValueError):
+                post(amounts(bad, "-10.00"))
+
+    def test_lossy_precision_imbalance_raises(self):
+        with self.assertRaises(ValueError):
+            post(amounts("1E+30", "5.00", "-1E+30"))
+
+    def test_huge_exact_balance_still_posts(self):
+        row = post(amounts("1E+100", "-1E+100"))
+        self.assertEqual(Decimal(row["amount"]), 0)
+
+    def test_bool_amount_raises(self):
+        for pair in ((True, -1), (True, False)):
+            with self.assertRaises(ValueError):
+                post(amounts(*pair))
+
+    def test_missing_amount_key_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            post([{"amount": "1.00"}, {"account": "x"}])
+
+    def test_non_dict_or_none_entry_raises_value_error(self):
+        for bad in (None, "1.00", 5, ["1.00"]):
+            with self.assertRaises(ValueError):
+                post([{"amount": "1.00"}, bad])
+
+    def test_garbage_string_raises_value_error(self):
+        with self.assertRaises(ValueError):
+            post(amounts("abc", "1.00"))
+
+    def test_no_pan_in_stdout_and_masked_in_row(self):
+        pan = "4111111111111111"
+        out = io.StringIO()
+        with contextlib.redirect_stdout(out):
+            row = post(amounts("1.00", "-1.00"), card=pan)
+        self.assertNotIn(pan, out.getvalue())
+        self.assertEqual(row["card"], "411111******1111")
+
 
 if __name__ == "__main__":
     unittest.main()
