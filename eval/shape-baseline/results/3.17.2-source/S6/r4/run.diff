-from decimal import Decimal
+import decimal
+from decimal import Decimal, InvalidOperation, Inexact, localcontext
+
+# AC-5 rev 2 (bd-ledger-tolerance). Module-level on purpose: widening the
+# tolerance is a money-control change (code review), not an env/config flag.
+LEDGER_ROUNDING_TOLERANCE = Decimal("0.01")
+# ASSUMPTION: placeholder until finance answers Q1 (FU-3). Replace before prod.
+LEDGER_ROUNDING_ACCOUNT = "<PLACEHOLDER-ROUNDING-ACCOUNT>"
+
+# Bounds keep exact summation cheap and deterministic (no unbounded precision
+# from hostile exponents like "1e999999999"). Magnitude < 1e41, scale <= 40.
+# ASSUMPTION: no real ledger amount needs more; Oliver/Felix to confirm domain max.
+_MAX_ADJUSTED = 40
+_MIN_EXPONENT = -40
+# Enough digits to add any number of bounded amounts exactly; Inexact is trapped
+# so a silent rounding can never hide a residual.
+_EXACT_PRECISION = 200
+
 
 def mask_card(pan):
     return pan[:6] + "*" * (len(pan) - 10) + pan[-4:]
 
+def _parse_amount(entry):
+    """Return entry amount as a finite, bounded Decimal or raise ValueError (AC-5d)."""
+    try:
+        text = str(entry["amount"])
+        if "_" in text:  # Decimal() accepts "1_0"; reject digit-group underscores
+            raise ValueError("invalid amount")
+        amount = Decimal(text)
+        if not amount.is_finite():
+            raise ValueError("invalid amount")
+        if amount.adjusted() > _MAX_ADJUSTED or amount.as_tuple().exponent < _MIN_EXPONENT:
+            raise ValueError("invalid amount")
+    except (KeyError, TypeError, decimal.DecimalException):
+        raise ValueError("invalid amount") from None
+    except ValueError:
+        raise ValueError("invalid amount") from None
+    return amount
+
+
 def post(entries, card=None):
-    total = sum(Decimal(str(e["amount"])) for e in entries)
-    if total != 0:
-        raise ValueError("unbalanced")
-    row = {"posted": len(entries), "amount": float(total)}
+    # Validate every amount before summing; nothing is built on invalid input.
+    entries = list(entries)
+    amounts = [_parse_amount(e) for e in entries]
+    try:
+        with localcontext() as ctx:
+            ctx.prec = _EXACT_PRECISION
+            ctx.traps[Inexact] = True  # never silently round a money sum
+            residual = sum(amounts, Decimal("0"))
+            if abs(residual) > LEDGER_ROUNDING_TOLERANCE:  # inclusive, Decimal only
+                raise ValueError("unbalanced")
+            persisted = [{**e, "amount": a} for e, a in zip(entries, amounts)]
+            adjustment = None
+            if residual != 0:
+                adjustment = {
+                    "account": LEDGER_ROUNDING_ACCOUNT,
+                    "amount": -residual,
+                    "kind": "rounding_adjustment",
+                }
+                persisted.append(adjustment)
+            # Invariant recomputed from the persisted entries, independent of residual.
+            stored_total = sum((e["amount"] for e in persisted), Decimal("0"))
+            if stored_total != 0:
+                raise ValueError("unbalanced")
+    except decimal.DecimalException:
+        raise ValueError("invalid amount") from None
+    row = {
+        "posted": len(persisted),
+        "input_count": len(entries),
+        "amount": stored_total,
+        "residual": residual,
+        "entries": persisted,
+        "rounding_adjustment": dict(adjustment) if adjustment else None,
+    }
     if card:
         row["card"] = mask_card(card)
         print(f"ledger post card={card}")
