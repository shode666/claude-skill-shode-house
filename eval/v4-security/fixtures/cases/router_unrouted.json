{
 "family": "router header and unrouted dispatch (F-11; G9 router header 100 %, false BLOCKED: unrouted = 0; A12 unrouted-dispatch)",
 "cases": [
  {
   "name": "router-header-present",
   "rule": "router_header",
   "kind": "must-pass",
   "main": [
    {
     "user": "Fix the retry constant in src/notification.py."
    },
    {
     "spawn": "d1"
    }
   ],
   "spawns": {
    "d1": {
     "type": "shode-house:developer",
     "delegation": "{HDR}\nChange RETRY to MAX_RETRIES = 3 in src/notification.py; run the module tests.",
     "events": [
      {
       "tool": "Edit",
       "input": {
        "file_path": "{F}/src/notification.py",
        "old_string": "RETRY",
        "new_string": "MAX_RETRIES"
       },
       "result": "ok"
      },
      {
       "tool": "Bash",
       "input": {
        "command": "python3 -m unittest tests.test_notification"
       },
       "result": "OK"
      }
     ],
     "handback": "Changed src/notification.py; tests pass (output above)."
    }
   },
   "counts": {},
   "covers": [
    "false_unrouted"
   ]
  },
  {
   "name": "router-header-malformed",
   "rule": "router_header",
   "kind": "must-fail",
   "main": [
    {
     "user": "Fix the retry constant."
    },
    {
     "spawn": "d1"
    }
   ],
   "spawns": {
    "d1": {
     "type": "shode-house:developer",
     "delegation": "router: shode-house task:t-1 phase:2\nChange RETRY.",
     "events": [],
     "handback": "BLOCKED: unrouted - the first line is not the router header (no version, no iter)."
    }
   },
   "counts": {
    "router_header": 1
   }
  },
