   "main": [
    {
     "user": "Review the change."
    },
    {
     "spawn": "cr"
    }
   ],
   "spawns": {
    "cr": {
     "type": "shode-house:code-reviewer",
     "delegation": "{HDR}\nStandards review, round 2. Change list outputs/t-1/04-change-list.md.",
     "events": [
      {
       "tool": "Read",
       "input": {
        "file_path": "{F}/outputs/t-1/03-review-standards-iter1.md"
       },
       "result": "my earlier findings"
      },
      {
       "tool": "Read",
       "input": {
        "file_path": "{F}/outputs/t-1/04-change-list.md"
       },
       "result": "src/ledger.py"
      },
      {
       "tool": "Glob",
       "input": {
        "pattern": "outputs/t-1/*"
       },
       "result": "outputs/t-1/04-change-list.md\noutputs/t-1/07-review-spec-iter1.md"
      },
      {
       "tool": "Grep",
       "input": {
        "pattern": "float",
        "path": "{F}/src"
       },
       "result": "{F}/src/ledger.py:12: amount = float(x)"
      },
      {
       "tool": "Bash",
       "input": {
        "command": "cat src/ledger.py && python3 -m unittest tests.test_ledger"
       },
       "result": "OK"
      },
      {
       "tool": "Write",
       "input": {
        "file_path": "{F}/outputs/t-1/08-review-standards-iter2.md",
        "content": "x"
       },
       "result": "ok"
      }
     ],
     "handback": "Standards: 1 finding (float money)."
